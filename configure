#!/bin/bash
#
# Configure script for PREDICT satellite tracking program.
# Detects dependencies, generates predict.h and a Makefile.
#
# Usage: ./configure [--prefix=DIR]
#   Default prefix: /usr/local
#
# Then: make && sudo make install

set -e

PREFIX="/usr/local"
VOCALIZER_ENABLED=no
for arg in "$@"; do
    case "$arg" in
        --prefix=*)         PREFIX="${arg#--prefix=}" ;;
        --enable-vocalizer) VOCALIZER_ENABLED=yes ;;
        --help)
            echo "Usage: ./configure [--prefix=DIR] [--enable-vocalizer]"
            echo "  --prefix=DIR        Install to DIR (default: /usr/local)"
            echo "  --enable-vocalizer  Build the vocalizer (requires /dev/dsp)"
            exit 0 ;;
        *) echo "Unknown option: $arg"; exit 1 ;;
    esac
done

SRC_DIR="$(pwd)"
VERSION="$(cat .version)"
CC="${CC:-cc}"

pass() { echo "yes"; }
fail() { echo "no"; echo "ERROR: $1" >&2; exit 1; }

# --- compiler ---
printf "Checking for C compiler (%s)... " "$CC"
echo "int main(){return 0;}" > /tmp/cctest.c
$CC /tmp/cctest.c -o /tmp/cctest 2>/dev/null && pass || fail "C compiler not found. Install gcc or set CC."
rm -f /tmp/cctest.c /tmp/cctest

# --- pthreads ---
printf "Checking for pthreads... "
echo "int main(){return 0;}" > /tmp/cctest.c
$CC /tmp/cctest.c -lpthread -o /tmp/cctest 2>/dev/null && pass || fail "pthreads library not found. Install libc6-dev or equivalent."
rm -f /tmp/cctest.c /tmp/cctest

# --- ncurses ---
printf "Checking for ncurses... "
echo "#include <curses.h>" > /tmp/cctest.c
echo "int main(){initscr();endwin();return 0;}" >> /tmp/cctest.c
$CC /tmp/cctest.c -lncurses -o /tmp/cctest 2>/dev/null && pass || fail "ncurses library not found. Install libncurses-dev or equivalent."
rm -f /tmp/cctest.c /tmp/cctest

# --- math ---
printf "Checking for math library... "
echo "#include <math.h>" > /tmp/cctest.c
echo "int main(){return (int)sin(0);}" >> /tmp/cctest.c
$CC /tmp/cctest.c -lm -o /tmp/cctest 2>/dev/null && pass || fail "math library not found."
rm -f /tmp/cctest.c /tmp/cctest

# --- soundcard ---
if [ "$VOCALIZER_ENABLED" = "yes" ]; then
    printf "Checking for soundcard (/dev/dsp)... "
    if [ -w /dev/dsp ] 2>/dev/null; then
        SOUNDCARD=1
        echo "yes"
    else
        SOUNDCARD=0
        echo "no (vocalizer will not be built)"
    fi
else
    SOUNDCARD=0
    printf "Checking for soundcard (/dev/dsp)... skipped\n"
fi

# --- generate predict.h ---
cat > predict.h <<EOF
/* Generated by configure -- do not edit */

char *predictpath={"${SRC_DIR}/"}, soundcard=${SOUNDCARD}, *version={"${VERSION}"};
EOF
echo "Generated predict.h"

# --- generate vocalizer/vocalizer.h ---
cat > vocalizer/vocalizer.h <<EOF
/* Generated by configure -- do not edit */

char *path={"${SRC_DIR}/vocalizer/"};
EOF
echo "Generated vocalizer/vocalizer.h"

# --- generate Makefile ---
VOCALIZER_RULE=""
VOCALIZER_CLEAN=""
VOCALIZER_INSTALL=""
VOCALIZER_UNINSTALL=""
if [ "$SOUNDCARD" = "1" ]; then
    VOCALIZER_RULE="vocalizer/vocalizer"
    VOCALIZER_CLEAN="	rm -f vocalizer/vocalizer"
    VOCALIZER_INSTALL="	install -m 755 vocalizer/vocalizer \$(PREFIX)/bin/vocalizer"
    VOCALIZER_UNINSTALL="	rm -f ${PREFIX}/bin/vocalizer"
fi

cat > Makefile <<EOF
# Generated by configure -- do not edit

CC      = ${CC}
CFLAGS  = -Wall -O3 -s -fomit-frame-pointer
LIBS    = -lm -lncurses -lpthread
PREFIX  = ${PREFIX}
SRCDIR  = ${SRC_DIR}

.PHONY: all install uninstall clean distclean

all: predict ${VOCALIZER_RULE}

predict: predict.c predict.h
	\$(CC) \$(CFLAGS) predict.c \$(LIBS) -o predict

vocalizer/vocalizer: vocalizer/vocalizer.c vocalizer/vocalizer.h
	\$(CC) \$(CFLAGS) vocalizer/vocalizer.c -o vocalizer/vocalizer

install: all
	install -d \$(PREFIX)/bin
	install -m 755 predict \$(PREFIX)/bin/predict
	install -m 755 kepupdate \$(PREFIX)/bin/kepupdate
	install -d \$(PREFIX)/share/man/man1
	install -m 644 docs/man/predict.1 \$(PREFIX)/share/man/man1/predict.1
${VOCALIZER_INSTALL}

uninstall:
	rm -f \$(PREFIX)/bin/predict
	rm -f \$(PREFIX)/bin/kepupdate
	rm -f \$(PREFIX)/bin/kep_update
	rm -f \$(PREFIX)/bin/earthtrack
	rm -f \$(PREFIX)/bin/earthtrack2
	rm -f \$(PREFIX)/bin/geosat
	rm -f \$(PREFIX)/bin/map
	rm -f \$(PREFIX)/share/man/man1/predict.1
${VOCALIZER_UNINSTALL}

clean:
	rm -f predict predict.h vocalizer/vocalizer.h
${VOCALIZER_CLEAN}

distclean: clean
	rm -f vocalizer/vocalizer
	rm -f clients/samples/demo
	rm -f clients/map/map
	rm -f clients/earthtrack/earthtrack
	rm -f clients/kep_reload/kep_reload
	rm -f utils/moontracker/moontracker
	rm -f utils/geosat/geosat
	\$(MAKE) -C clients/gsat-1.1.0 clean 2>/dev/null || true
EOF
echo "Generated Makefile"

echo ""
echo "PREDICT v${VERSION} configured."
echo "  Source:  ${SRC_DIR}"
echo "  Prefix:  ${PREFIX}"
if [ "$SOUNDCARD" = "1" ]; then
    echo "  Sound:   yes"
elif [ "$VOCALIZER_ENABLED" = "yes" ]; then
    echo "  Sound:   no (no /dev/dsp found)"
else
    echo "  Sound:   disabled (use --enable-vocalizer to build)"
fi
echo ""
echo "Now run: make && sudo make install"
