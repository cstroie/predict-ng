#!/bin/bash
# kepupdate - fetch current TLE data from Celestrak and update PREDICT's
# orbital database. Run manually or via cron.
#
# Celestrak GP data API: https://celestrak.org/NORAD/elements/gp.php?GROUP=<name>&FORMAT=tle

PREDICT="${PREDICT:-predict}"
TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT

BASE_URL="https://celestrak.org/NORAD/elements/gp.php"

fetch() {
    local group="$1"
    local dest="$TMPDIR/${group}.tle"
    if wget -q "${BASE_URL}?GROUP=${group}&FORMAT=tle" -O "$dest"; then
        "$PREDICT" -u "$dest"
    else
        echo "kepupdate: failed to fetch group '${group}'" >&2
    fi
}

fetch amateur
fetch visual
fetch weather
fetch stations

kep_reload localhost
